PORT=3000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/llm-gateway?retryWrites=true&w=majority
REDIS_URI=redis://redis:6379

# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_production_api_key_here
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
